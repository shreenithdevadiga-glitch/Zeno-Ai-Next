# ============================================================
# ZENO AI NEXT - Production Environment Configuration Reference
# ============================================================

# Platform Core
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_hmac_signing_key_minimum_32_characters

# Database (Leave empty for embedded SQLite WAL mode, or provide PostgreSQL for multi-replica scaling)
# DATABASE_URL=postgres://zeno:zenopass@localhost:5432/zeno_production

# Redis & BullMQ Distributed Job Queue (Leave empty for in-memory worker queues)
# REDIS_URL=redis://localhost:6379

# Object Storage (AWS S3, Cloudflare R2, or MinIO - leave empty for local disk uploads)
# S3_BUCKET=zeno-production-storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Core AI Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search & Deep Research
TAVILY_API_KEY=
SEARCH_API_KEY=

# Image & Multimodal Generation
POLLINATIONS_API_KEY=
IMAGE_API_KEY=

# Voice & Speech Telemetry
STT_API_KEY=
TTS_API_KEY=

# Google Weather & Geospatial Radar (Optional)
GOOGLE_MAPS_API_KEY=

# ============================================================
# Administrator Provisioning & Password Recovery System
# ============================================================
# Initial Super Admin Provisioning (Never hardcode secrets in source or Git)
ADMIN_EMAIL=shreenithdevadiga@gmail.com
# ADMIN_INITIAL_PASSWORD=SetSecureSecretDuringDeploymentOnly

# Real Transactional Email Provider (resend | sendgrid | postmark | smtp)
EMAIL_PROVIDER=resend
EMAIL_FROM=security@zenoai.com
EMAIL_API_KEY=
# SMTP configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Real SMS Provider (twilio | sns | messagebird)
SMS_PROVIDER=twilio
SMS_FROM=
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cryptographic OTP Security Policies
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
